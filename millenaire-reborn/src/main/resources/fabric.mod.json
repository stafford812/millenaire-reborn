{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "Millenaire Reborn",
    "description": "Autonomous villages with their own economy, culture, NPCs and construction. A server-centric mod for Minecraft 1.21.11 Fabric.",
    "authors": [
        "Millenaire Team",
        "Stafford812"
    ],
    "contact": {
        "homepage": "https://github.com/stafford812/millenaire-reborn",
        "sources": "https://github.com/stafford812/millenaire-reborn",
        "issues": "https://github.com/stafford812/millenaire-reborn/issues"
    },
    "license": "CC0-1.0",
    "icon": "assets/millenaire/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.millenaire.core.MillenaireReborn"
        ],
        "client": [
            "com.millenaire.client.MillenaireRebornClient"
        ]
    },
    "mixins": [
        "millenaire.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.18.1",
        "minecraft": "~1.21.11",
        "java": ">=21",
        "fabric-api": "*"
    }
